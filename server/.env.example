# VoiceFlow Backend Environment Configuration Template

# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# Node Environment ('production' for Render, 'development' for local)
NODE_ENV=production

# Frontend Client URL for CORS (e.g. https://your-frontend-name.netlify.app or https://your-frontend-name.vercel.app)
# Any *.netlify.app and *.vercel.app domain is also automatically supported
CLIENT_ORIGIN=https://your-frontend-name.netlify.app

# Firebase Project ID
FIREBASE_PROJECT_ID=voiceflow-f53b8

# Firebase Admin Service Account Key (optional but recommended for privileged operations)
# On Render: paste the raw JSON content directly as a single-line or multi-line environment variable
# Locally: path to serviceAccountKey.json or raw JSON
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Gemini API Key
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
