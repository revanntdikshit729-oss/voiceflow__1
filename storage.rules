rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Patient profile photos: authenticated patients can only write to their own folder
    match /profile_photos/patients/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Doctor profile photos: authenticated doctors can only write to their own folder
    match /profile_photos/doctors/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
