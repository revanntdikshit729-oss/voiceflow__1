# VoiceFlow Client Environment Configuration Template

# Backend API URL (leave empty for local development to use Vite proxy; set to your deployed Render URL for production)
# e.g.: VITE_API_URL=https://your-backend-name.onrender.com
VITE_API_URL=

# Firebase Client Configuration
# Copy these values from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/Configuration
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=voiceflow-f53b8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=voiceflow-f53b8
VITE_FIREBASE_STORAGE_BUCKET=voiceflow-f53b8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
